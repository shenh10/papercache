---
layout: null
---

<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
  <link href="{{ site.url }}{{ site.baseurl }}/feed.xml" rel="self" type="application/atom+xml" />
  <link href="{{ site.url }}{{ site.baseurl }}/" rel="alternate" type="text/html" />
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ site.url }}{{ site.baseurl }}/feed.xml</id>
  <title type="html">{{ site.title | escape }} - 最新收录</title>
  <subtitle>按添加到 PaperCache 的时间排序的最新 {{ site.title | escape }} 论文</subtitle>
  <author>
    <name>{{ site.author.name }}</name>
    <email>{{ site.author.email }}</email>
  </author>
  {%- comment -%} 按 added_date 排序（如果存在），否则使用 date {%- endcomment -%}
  {%- assign posts_with_added_date = '' | split: '' -%}
  {%- assign posts_without_added_date = '' | split: '' -%}
  {%- comment -%} 分离有 added_date 和没有 added_date 的文章 {%- endcomment -%}
  {%- for post in site.posts -%}
    {%- if post.added_date -%}
      {%- assign posts_with_added_date = posts_with_added_date | push: post -%}
    {%- else -%}
      {%- assign posts_without_added_date = posts_without_added_date | push: post -%}
    {%- endif -%}
  {%- endfor -%}
  {%- comment -%} 按 added_date 排序有 added_date 的文章 {%- endcomment -%}
  {%- assign sorted_with_added = posts_with_added_date | sort: 'added_date' | reverse -%}
  {%- comment -%} 按 date 排序没有 added_date 的文章 {%- endcomment -%}
  {%- assign sorted_without_added = posts_without_added_date | sort: 'date' | reverse -%}
  {%- comment -%} 合并：先是有 added_date 的（按 added_date 倒序），然后是没 added_date 的（按 date 倒序）{%- endcomment -%}
  {%- assign all_sorted_posts = '' | split: '' -%}
  {%- for post in sorted_with_added -%}
    {%- assign all_sorted_posts = all_sorted_posts | push: post -%}
  {%- endfor -%}
  {%- for post in sorted_without_added -%}
    {%- assign all_sorted_posts = all_sorted_posts | push: post -%}
  {%- endfor -%}
  {%- assign latest_posts = all_sorted_posts | limit: 10 -%}
  {% for post in latest_posts %}
  <entry>
    <title type="html">{{ post.title | escape }}</title>
    <link href="{{ site.url }}{{ site.baseurl }}{{ post.url }}" rel="alternate" type="text/html" title="{{ post.title | escape }}" />
    {%- assign publish_date = post.added_date | default: post.date -%}
    <published>{{ publish_date | date_to_xmlschema }}</published>
    <updated>{{ publish_date | date_to_xmlschema }}</updated>
    <id>{{ site.url }}{{ site.baseurl }}{{ post.url }}</id>
    <content type="html" xml:base="{{ site.url }}{{ site.baseurl }}{{ post.url }}">
      <![CDATA[{{ post.excerpt | strip_html | truncate: 200 | escape }}]]>
    </content>
    {%- if post.categories.size > 0 -%}
    <category term="{{ post.categories | first | escape }}" />
    {%- endif -%}
  </entry>
  {% endfor %}
</feed>
