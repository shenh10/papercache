// 用户认证服务模块
(function() {
  'use strict';

  // 等待Supabase客户端初始化
  function getSupabaseClient() {
    if (window.getSupabaseClient) {
      return window.getSupabaseClient();
    }
    return null;
  }

  const supabase = getSupabaseClient();
  
  if (!supabase) {
    console.warn('Supabase客户端未初始化，等待初始化...');
    // 等待客户端初始化，最多等待3秒
    let waitCount = 0;
    const checkInterval = setInterval(() => {
      waitCount++;
      const client = getSupabaseClient();
      if (client) {
        clearInterval(checkInterval);
        initAuthService(client);
      } else if (waitCount > 30) {
        clearInterval(checkInterval);
        console.error('Supabase客户端初始化超时，认证功能不可用');
      }
    }, 100);
    return;
  }
  
  initAuthService(supabase);
  
  function initAuthService(supabase) {
    // ============================================
    // 认证状态管理
    // ============================================
    
    // 使用全局变量持久化用户状态，避免页面跳转时丢失
    // 如果已经有全局状态，先恢复它
    let currentUser = window._authCurrentUser || null;
    let authStateListeners = [];
    
    // 记录初始状态（用于调试）
    console.log('auth.js initAuthService: 📊 初始化状态统计', {
      'currentUser': currentUser ? `${currentUser.email} (${currentUser.id})` : 'null',
      'window._authCurrentUser': window._authCurrentUser ? `${window._authCurrentUser.email} (${window._authCurrentUser.id})` : 'null',
      '两者是否一致': currentUser === window._authCurrentUser ? '是' : '否'
    });
    
    // 如果全局状态不存在，立即尝试从Supabase session恢复（不等待init()）
    // 这样可以避免页面一开始显示未登录状态
    if (!currentUser && supabase) {
      console.log('auth.js initAuthService: 全局状态为空，尝试快速恢复session...');
      // 异步快速检查session（不阻塞后续代码）
      supabase.auth.getSession().then(({ data: { session }, error }) => {
        if (!error && session?.user) {
          console.log('auth.js initAuthService: ✅ 从session快速恢复用户状态', session.user.email);
          // 立即恢复基本用户状态（不等待profile加载）
          currentUser = {
            ...session.user,
            profile: null // 稍后加载
          };
          window._authCurrentUser = currentUser;
          console.log('auth.js initAuthService: ✅ 立即设置全局状态（从session快速恢复）');
          
          // 延迟通知监听器，确保UI组件已加载
          setTimeout(() => {
            authStateListeners.forEach(listener => {
              try {
                listener(currentUser, 'SIGNED_IN');
              } catch (e) {
                console.error('Auth state listener error (session restore):', e);
              }
            });
            updateAuthUI();
            console.log('auth.js initAuthService: ✅ UI已立即更新（从session快速恢复）');
          }, 10); // 稍微延迟，确保UI组件已注册监听器
        } else if (error) {
          console.warn('auth.js initAuthService: 快速恢复session失败', error);
        }
      }).catch(err => {
        console.warn('auth.js initAuthService: 快速恢复session异常', err);
      });
    }
    
    // 如果从全局恢复了用户状态，立即通知监听器（这样页面跳转时不会丢失状态）
    if (currentUser && currentUser === window._authCurrentUser) {
      console.log('auth.js: ✅ 从全局状态恢复用户', currentUser.email, 'ID:', currentUser.id);
      // 立即通知所有已注册的监听器（这样UI可以立即更新，不等待init()完成）
      // 注意：监听器可能还没有注册，但会记录在authStateListeners中，init()时会再次通知
      setTimeout(() => {
        authStateListeners.forEach(listener => {
          try {
            listener(currentUser, 'SIGNED_IN');
          } catch (e) {
            console.error('Auth state listener error (early init):', e);
          }
        });
        // 如果已经有监听器，也立即更新UI
        if (authStateListeners.length > 0) {
          updateAuthUI();
          console.log('auth.js: ✅ 已通知监听器并更新UI（从全局状态恢复）');
        }
      }, 0);
      // 验证状态是否仍然有效（通过检查session）
      // 注意：这里不等待验证完成，先恢复状态，验证在init()中进行
    }

    // 获取当前用户
    async function getCurrentUser() {
      try {
        // 先尝试从session获取（更快，从localStorage读取，这是持久化的状态）
        const { data: { session }, error: sessionError } = await supabase.auth.getSession();
        
        if (sessionError) {
          console.warn('获取session失败:', sessionError);
        }
        
        // 如果有session，使用session中的user（这是持久化的状态）
        if (session?.user) {
          console.log('getCurrentUser: 从session获取用户', session.user.email);
          
          // 获取用户档案（如果不存在会自动创建，即使失败也返回默认profile）
          let profile = null;
          try {
            profile = await getUserProfile(session.user.id);
          } catch (profileError) {
            console.error('getCurrentUser: 获取profile失败，使用默认值', profileError);
            // getUserProfile现在应该永远不会返回null，但为了安全还是处理一下
            profile = {
              id: session.user.id,
              username: session.user.user_metadata?.username || session.user.email?.split('@')[0] || 'user',
              avatar_url: session.user.user_metadata?.avatar_url || null,
              full_name: session.user.user_metadata?.full_name || null,
              bio: null
            };
          }
          
          // 确保profile不为null
          if (!profile) {
            profile = {
              id: session.user.id,
              username: session.user.user_metadata?.username || session.user.email?.split('@')[0] || 'user',
              avatar_url: session.user.user_metadata?.avatar_url || null,
              full_name: session.user.user_metadata?.full_name || null,
              bio: null
            };
          }
          
          currentUser = {
            ...session.user,
            profile: profile
          };
          // 同步到全局变量
          window._authCurrentUser = currentUser;
          return currentUser;
        }
        
        // 如果没有session，再尝试getUser（可能token已过期但refresh token还有效）
        console.log('getCurrentUser: session为空，尝试getUser');
        const { data: { user }, error } = await supabase.auth.getUser();
        if (error) {
          // 如果getUser也失败，清除状态
          console.log('getCurrentUser: getUser失败', error.message);
          currentUser = null;
          return null;
        }
        
        // 如果用户存在，获取用户档案（如果不存在会自动创建）
        if (user) {
          console.log('getCurrentUser: getUser成功', user.email);
          let profile = null;
          try {
            profile = await getUserProfile(user.id);
          } catch (profileError) {
            console.error('getCurrentUser: 获取profile失败，使用默认值', profileError);
            // getUserProfile现在应该永远不会返回null，但为了安全还是处理一下
            profile = {
              id: user.id,
              username: user.user_metadata?.username || user.email?.split('@')[0] || 'user',
              avatar_url: user.user_metadata?.avatar_url || null,
              full_name: user.user_metadata?.full_name || null,
              bio: null
            };
          }
          
          // 确保profile不为null
          if (!profile) {
            profile = {
              id: user.id,
              username: user.user_metadata?.username || user.email?.split('@')[0] || 'user',
              avatar_url: user.user_metadata?.avatar_url || null,
              full_name: user.user_metadata?.full_name || null,
              bio: null
            };
          }
          
          currentUser = {
            ...user,
            profile: profile
          };
          // 同步到全局变量
          window._authCurrentUser = currentUser;
        } else {
          currentUser = null;
          window._authCurrentUser = null;
        }
        
        return currentUser;
      } catch (error) {
        console.error('获取当前用户失败:', error);
        currentUser = null;
        return null;
      }
    }

    // 创建带超时的Promise包装器
    function withTimeout(promise, timeoutMs = 5000, operation = '操作') {
      return Promise.race([
        promise,
        new Promise((_, reject) => 
          setTimeout(() => reject(new Error(`${operation}超时（${timeoutMs}ms）- 可能是数据库连接问题或RLS策略限制`)), timeoutMs)
        )
      ]);
    }

    // 用户profile缓存
  const profileCache = new Map();
  const PROFILE_CACHE_TTL = 60000; // 1分钟缓存

  // 追踪正在进行的profile请求
  const pendingProfileRequests = new Map();

  // 获取用户档案（如果不存在则自动创建）
    async function getUserProfile(userId) {
      console.log('getUserProfile: 开始获取用户档案', userId);

      // 检查是否有正在进行的请求
      const pendingRequest = pendingProfileRequests.get(userId);
      if (pendingRequest) {
        console.log('getUserProfile: ⏳ 有正在进行的请求，等待结果...');
        return pendingRequest;
      }

      // 检查缓存
      const cached = profileCache.get(userId);
      if (cached && Date.now() - cached.timestamp < PROFILE_CACHE_TTL) {
        console.log('getUserProfile: ✅ 使用缓存的profile数据');
        return cached.profile;
      }

      // 创建并追踪请求Promise
      const profilePromise = (async () => {
        try {
          // 检查Supabase客户端
          if (!supabase) {
            console.error('getUserProfile: Supabase客户端不可用');
            const defaultProfile = createDefaultProfile(userId);
            return defaultProfile;
          }

          // 测试数据库连接
          console.log('getUserProfile: 测试数据库连接...');
          try {
            const { data: testData, error: testError } = await Promise.race([
              supabase.from('profiles').select('id').limit(1),
              new Promise((_, reject) => setTimeout(() => reject(new Error('连接测试超时')), 3000))
            ]);

            if (testError) {
              console.warn('getUserProfile: 数据库连接测试失败', testError.code, testError.message);
            } else {
              console.log('getUserProfile: ✅ 数据库连接正常');
            }
          } catch (testErr) {
            console.error('getUserProfile: 数据库连接测试异常', testErr.message);
            // 连接测试失败，但仍然尝试查询profile
          }

          try {
            // 查询profile，添加超时保护（5秒，给更多时间）
            console.log(`getUserProfile: 🔍 开始查询profile（userId: ${userId}）...`);
            console.log('getUserProfile: Supabase客户端状态:', supabase ? '可用' : '不可用');

            const queryStartTime = Date.now();
            const { data, error } = await Promise.race([
              supabase
                .from('profiles')
                .select('*')
                .eq('id', userId)
                .single(),
              new Promise((_, reject) =>
                setTimeout(() => reject(new Error('查询profile超时')), 5000)
              )
            ]);

            const queryDuration = Date.now() - queryStartTime;
            console.log(`getUserProfile: 📥 查询响应（耗时${queryDuration}ms）`, error ? `错误: ${error.code}` : '成功');

            if (error) {
              console.log('getUserProfile: 查询出错', error.code, error.message);

              // 如果错误是"没有找到记录"（PGRST116），说明profile不存在，需要创建
              if (error.code === 'PGRST116' || error.message?.includes('0 rows') || error.message?.includes('JSON object requested, multiple')) {
                console.log('getUserProfile: 用户档案不存在，首次登录时创建profile', userId);
                const newProfile = await createUserProfile(userId);
                return newProfile;
              }

              // 其他错误，返回默认profile
              console.warn('getUserProfile: 其他错误，返回默认profile', error.code, error.message);
              const defaultProfile = createDefaultProfile(userId);
              return defaultProfile;
            }

            console.log('getUserProfile: 查询成功，返回profile数据');

            // 缓存结果
            profileCache.set(userId, {
              profile: data,
              timestamp: Date.now()
            });

            return data;
          } catch (error) {
            console.error('getUserProfile: 异常', error.message || error);
            // 即使出错或超时，也返回默认的 profile 对象
            const defaultProfile = createDefaultProfile(userId);
            return defaultProfile;
          }
        } finally {
          // 请求完成后，从pending请求映射中移除
          pendingProfileRequests.delete(userId);
          console.log('getUserProfile: ✅ 请求完成，移除pending标记');
        }
      })();

      // 将Promise添加到pending请求映射
      pendingProfileRequests.set(userId, profilePromise);
      console.log('getUserProfile: 📝 添加pending请求标记');

      return profilePromise;
    }

    // 创建默认profile对象
    function createDefaultProfile(userId, user = null) {
      return {
        id: userId,
        username: user?.user_metadata?.username || user?.email?.split('@')[0] || 'user',
        avatar_url: user?.user_metadata?.avatar_url || null,
        full_name: user?.user_metadata?.full_name || null,
        bio: null
      };
    }

    // 创建用户profile（如果不存在）
    async function createUserProfile(userId) {
      try {
        // 获取用户基本信息
        let user = null;
        try {
          const { data: { user: userData } } = await Promise.race([
            supabase.auth.getUser(),
            new Promise((_, reject) => setTimeout(() => reject(new Error('获取用户信息超时')), 1000))
          ]);
          user = userData;
        } catch (e) {
          console.warn('getUserProfile: 获取用户信息超时', e);
        }

        // 准备profile数据
        const newProfile = createDefaultProfile(userId, user);

        // 尝试创建profile（快速，不阻塞登录）
        console.log('getUserProfile: 🔵 开始创建profile（首次登录）');
        const startCreateTime = Date.now();

        try {
          const { data, error } = await Promise.race([
            supabase
              .from('profiles')
              .upsert(newProfile, { onConflict: 'id' })
              .select()
              .single(),
            new Promise((_, reject) => setTimeout(() => reject(new Error('创建profile超时')), 2000))
          ]);

          const createDuration = Date.now() - startCreateTime;
          if (data && !error) {
            console.log(`getUserProfile: ✅ profile创建成功（耗时${createDuration}ms）`, data);
            return data;
          } else {
            console.warn(`getUserProfile: ⚠️ profile创建失败（耗时${createDuration}ms）`, error?.code, error?.message);
            return newProfile;
          }
        } catch (createError) {
          const createDuration = Date.now() - startCreateTime;
          console.warn(`getUserProfile: ⏱️ profile创建超时（耗时${createDuration}ms），返回默认值，后台继续尝试...`, createError.message);

          // 后台继续尝试创建（不阻塞登录）
          supabase
            .from('profiles')
            .upsert(newProfile, { onConflict: 'id' })
            .select()
            .single()
            .then(({ data, error }) => {
              if (data && !error) {
                console.log('getUserProfile: ✅ 后台创建profile成功（已更新）', data);
                // 如果用户还在线，更新用户状态
                if (window._authCurrentUser && window._authCurrentUser.id === userId) {
                  window._authCurrentUser.profile = data;
                  updateAuthUI();
                }
              } else {
                console.warn('getUserProfile: ⚠️ 后台创建profile返回错误', error?.code, error?.message);
              }
            })
            .catch(err => {
              console.warn('getUserProfile: ❌ 后台创建profile失败', err.message || err);
            });

          // 立即返回默认profile，允许登录继续
          return newProfile;
        }
      } catch (error) {
        console.error('getUserProfile: 创建profile异常', error.message || error);
        return createDefaultProfile(userId);
      }
    }

    // 监听认证状态变化
    supabase.auth.onAuthStateChange(async (event, session) => {
      console.log('Auth state changed:', event, session?.user?.email || 'no session');
      
      // 处理邮箱验证确认
      if (event === 'SIGNUP_CONFIRMED') {
        console.log('邮箱验证成功');
        // 获取用户并更新状态
        const fullUser = await getCurrentUser();
        if (fullUser) {
          currentUser = fullUser;
          window._authCurrentUser = currentUser;
        } else if (session?.user) {
          // 如果getCurrentUser返回null，但session存在，使用session中的用户信息
          console.warn('SIGNUP_CONFIRMED: getCurrentUser返回null，使用session中的用户信息');
          currentUser = {
            ...session.user,
            profile: {
              id: session.user.id,
              username: session.user.user_metadata?.username || session.user.email?.split('@')[0] || 'user',
              avatar_url: session.user.user_metadata?.avatar_url || null,
              full_name: session.user.user_metadata?.full_name || null,
              bio: null
            }
          };
          window._authCurrentUser = currentUser;
        }
        if (session?.user) {
          await logUserLogin(session.user.id);
        }
        // 清除URL hash（如果存在）
        if (window.location.hash && window.location.hash.includes('access_token')) {
          setTimeout(() => {
            window.history.replaceState(null, '', window.location.pathname + window.location.search);
          }, 100);
        }
      } else if (event === 'PASSWORD_RECOVERY') {
        console.log('密码重置链接已确认');
        // 密码重置流程，由 reset-password.html 页面处理
      } else if (event === 'SIGNED_IN' || event === 'TOKEN_REFRESHED') {
        // SIGNED_IN: 用户登录
        // TOKEN_REFRESHED: token刷新，用户仍然登录，不应该清除状态
        console.log('onAuthStateChange: ✅ SIGNED_IN事件，开始恢复用户状态');
        let fullUser = null;
        try {
          // 尝试获取完整用户信息（包括profile），但不阻塞
          fullUser = await Promise.race([
            getCurrentUser(),
            new Promise((_, reject) => setTimeout(() => reject(new Error('getCurrentUser超时')), 5000))
          ]);
        } catch (getUserTimeout) {
          console.warn('onAuthStateChange: getCurrentUser超时，使用session信息', getUserTimeout.message);
          // 超时或失败时，使用session中的基本信息
        }
        
        if (fullUser) {
          console.log('onAuthStateChange: ✅ 获取到完整用户信息', fullUser.email);
          currentUser = fullUser;
          window._authCurrentUser = currentUser;
        } else {
          // 如果getCurrentUser返回null或超时，但session存在，使用session中的用户信息
          console.warn('onAuthStateChange: ⚠️ getCurrentUser返回null或超时，使用session中的用户信息');
          if (session?.user) {
            currentUser = {
              ...session.user,
              profile: {
                id: session.user.id,
                username: session.user.user_metadata?.username || session.user.email?.split('@')[0] || 'user',
                avatar_url: session.user.user_metadata?.avatar_url || null,
                full_name: session.user.user_metadata?.full_name || null,
                bio: null
              }
            };
            window._authCurrentUser = currentUser;
            console.log('onAuthStateChange: ✅ 使用session信息设置用户状态', currentUser.email);
            
            // 后台异步加载完整profile（不阻塞）
            getCurrentUser().then(completeUser => {
              if (completeUser && completeUser.id === currentUser.id) {
                console.log('onAuthStateChange: ✅ 后台加载完整profile成功');
                currentUser = completeUser;
                window._authCurrentUser = currentUser;
                // 通知监听器更新
                authStateListeners.forEach(listener => {
                  try {
                    listener(currentUser, 'SIGNED_IN');
                  } catch (e) {
                    console.error('Auth state listener error:', e);
                  }
                });
                updateAuthUI();
              }
            }).catch(err => {
              console.warn('onAuthStateChange: 后台加载完整profile失败（不影响登录状态）', err);
            });
          }
        }
        
        // 关键：无论是否获取到完整信息，都要通知监听器并更新UI
        console.log('onAuthStateChange: 📢 通知所有监听器更新UI');
        authStateListeners.forEach(listener => {
          try {
            listener(currentUser, 'SIGNED_IN');
          } catch (e) {
            console.error('Auth state listener error:', e);
          }
        });
        updateAuthUI();
        console.log('onAuthStateChange: ✅ UI已更新');
        
        // 记录登录日志（异步，不阻塞）
        if (session?.user) {
          logUserLogin(session.user.id).catch(err => {
            console.warn('记录登录日志失败:', err);
          });
        }
        // 如果是通过URL hash登录的，清除hash
        if (window.location.hash && window.location.hash.includes('access_token')) {
          setTimeout(() => {
            window.history.replaceState(null, '', window.location.pathname + window.location.search);
          }, 100);
        }
      } else if (event === 'SIGNED_OUT') {
        // 只有在明确收到 SIGNED_OUT 事件时才清除状态
        // 这是Supabase明确通知用户已登出（比如手动调用signOut或session真正过期）
        console.log('收到SIGNED_OUT事件，清除登录状态');
        currentUser = null;
        window._authCurrentUser = null;
      } else {
        // 其他事件（如USER_UPDATED），保持现有状态
        console.log('其他认证事件:', event);
        // 如果有session，确保状态是最新的
        if (session?.user && currentUser?.id === session.user.id) {
          // 用户仍然登录，只是可能信息有更新，不改变登录状态
          console.log('用户状态可能已更新，保持登录状态');
        }
      }
      
      // 通知所有监听器
      authStateListeners.forEach(listener => {
        try {
          listener(currentUser, event);
        } catch (e) {
          console.error('Auth state listener error:', e);
        }
      });
      
      // 更新UI
      updateAuthUI();
    });

    // 注册认证状态监听器
    function onAuthStateChange(callback) {
      authStateListeners.push(callback);
      // 立即调用一次（如果用户已经加载）
      if (currentUser !== undefined && currentUser !== null) {
        callback(currentUser, 'SIGNED_IN');
      } else if (currentUser === null) {
        // 如果明确是 null（已检查过但无用户），也调用一次
        callback(null, 'SIGNED_OUT');
      }
    }

    // ============================================
    // 登录功能
    // ============================================

    // OAuth登录
    async function signInWithOAuth(provider) {
      try {
        const { data, error } = await supabase.auth.signInWithOAuth({
          provider: provider, // 'github' 或 'google'
          options: {
            redirectTo: window.location.origin + window.location.pathname
          }
        });
        
        if (error) throw error;
        return { success: true, data };
      } catch (error) {
        console.error('OAuth登录失败:', error);
        return { success: false, error: error.message };
      }
    }

    // 邮箱/密码登录
    async function signInWithEmail(email, password) {
      try {
        console.log('signInWithEmail: 开始登录', email);

        // 检查Supabase客户端是否可用
        if (!supabase) {
          console.error('signInWithEmail: Supabase客户端不可用');
          return { success: false, error: '数据库连接不可用，请检查配置' };
        }

        // 执行Supabase认证（这是主要的登录操作，应该很快）
        const { data, error } = await supabase.auth.signInWithPassword({
          email,
          password
        });

        if (error) {
          console.log('signInWithEmail: 认证失败', error.message);
          throw error;
        }

        console.log('signInWithEmail: 认证成功，用户ID', data.user?.id);

        if (!data.user) {
          return { success: false, error: '登录失败：未获取到用户信息' };
        }

        // 立即创建基本用户对象，不等待profile加载
        const basicUser = {
          ...data.user,
          profile: {
            id: data.user.id,
            username: data.user.user_metadata?.username || data.user.email?.split('@')[0] || 'user',
            avatar_url: data.user.user_metadata?.avatar_url || null,
            full_name: data.user.user_metadata?.full_name || null,
            bio: null
          }
        };

        // 更新当前用户状态
        currentUser = basicUser;
        window._authCurrentUser = basicUser;

        // 立即通知所有监听器
        authStateListeners.forEach(listener => {
          try {
            listener(currentUser, 'SIGNED_IN');
          } catch (e) {
            console.error('Auth state listener error:', e);
          }
        });
        updateAuthUI();

        // 后台异步加载完整的用户信息（包括profile），不阻塞登录
        console.log('signInWithEmail: 🔄 后台异步加载完整profile（不阻塞登录）...');
        getCurrentUser().then(fullUser => {
          if (fullUser && fullUser.id === basicUser.id) {
            console.log('signInWithEmail: ✅ 后台加载完整用户信息成功');
            currentUser = fullUser;
            window._authCurrentUser = fullUser;
            // 更新UI显示完整信息
            authStateListeners.forEach(listener => {
              try {
                listener(currentUser, 'SIGNED_IN');
              } catch (e) {
                console.error('Auth state listener error:', e);
              }
            });
            updateAuthUI();
          }
        }).catch(err => {
          console.warn('signInWithEmail: ⚠️ 后台加载完整用户信息失败（不影响登录状态）', err.message || err);
        });

        // 记录登录日志（异步，不阻塞）
        logUserLogin(data.user.id).catch(err => {
          console.warn('记录登录日志失败:', err);
        });

        console.log('signInWithEmail: 登录完成');
        return { success: true, user: basicUser };
      } catch (error) {
        console.error('signInWithEmail: 登录失败', error.message || error);
        return { success: false, error: error.message || '登录失败' };
      }
    }

    // ============================================
    // 注册功能
    // ============================================

    // 邮箱注册
    async function signUpWithEmail(email, password, username) {
      try {
        // 使用验证页面作为邮箱验证回调地址
        const redirectTo = window.location.origin + '/papercache/auth/verify.html';
        
        const { data, error } = await supabase.auth.signUp({
          email,
          password,
          options: {
            emailRedirectTo: redirectTo,
            data: {
              username: username || email.split('@')[0]
            }
          }
        });
        
        if (error) throw error;
        return { success: true, user: data.user };
      } catch (error) {
        console.error('注册失败:', error);
        return { success: false, error: error.message };
      }
    }

    // ============================================
    // 密码重置
    // ============================================

    // 发送密码重置邮件
    async function resetPasswordForEmail(email) {
      try {
        // 使用重置页面作为重定向地址
        const redirectTo = window.location.origin + '/papercache/auth/reset-password.html';
        
        const { error } = await supabase.auth.resetPasswordForEmail(email, {
          redirectTo: redirectTo
        });
        
        if (error) throw error;
        return { success: true };
      } catch (error) {
        console.error('发送密码重置邮件失败:', error);
        return { success: false, error: error.message };
      }
    }

    // 更新密码
    async function updatePassword(newPassword) {
      try {
        const { error } = await supabase.auth.updateUser({
          password: newPassword
        });
        
        if (error) throw error;
        return { success: true };
      } catch (error) {
        console.error('更新密码失败:', error);
        return { success: false, error: error.message };
      }
    }

    // ============================================
    // 重发验证邮件
    // ============================================

    async function resendConfirmationEmail(email) {
      try {
        // 使用验证页面作为重定向地址
        const redirectTo = window.location.origin + '/papercache/auth/verify.html';
        
        const { error } = await supabase.auth.resend({
          type: 'signup',
          email: email,
          options: {
            emailRedirectTo: redirectTo
          }
        });
        
        if (error) throw error;
        return { success: true };
      } catch (error) {
        console.error('重发验证邮件失败:', error);
        return { success: false, error: error.message };
      }
    }

    // ============================================
    // 退出登录
    // ============================================

    async function signOut() {
      try {
        console.log('signOut: 开始退出登录');
        const { error } = await supabase.auth.signOut();
        if (error) throw error;
        
        // 清除用户状态（onAuthStateChange会自动处理，这里也清除以确保一致性）
        currentUser = null;
        window._authCurrentUser = null;
        updateAuthUI();
        console.log('signOut: 退出登录成功');
        return { success: true };
      } catch (error) {
        console.error('退出登录失败:', error);
        return { success: false, error: error.message };
      }
    }

    // ============================================
    // 登录日志
    // ============================================

    async function logUserLogin(userId) {
      try {
        // 获取IP地址（通过调用Supabase Edge Function或直接在客户端记录）
        // 注意：IP地址在客户端获取可能不准确，最好在服务器端记录
        const ipAddress = null; // 无法在客户端获取真实IP
        const userAgent = navigator.userAgent;
        
        // 调用数据库函数记录登录日志
        const { error } = await supabase.rpc('log_user_login', {
          p_user_id: userId,
          p_ip_address: null,
          p_user_agent: userAgent
        });
        
        if (error) {
          // 如果函数不存在，直接插入（需要确保RLS允许）
          console.warn('登录日志函数调用失败，尝试直接插入:', error);
          const { error: insertError } = await supabase
            .from('login_logs')
            .insert({
              user_id: userId,
              user_agent: userAgent
            });
          
          if (insertError) {
            console.error('记录登录日志失败:', insertError);
          }
        }
      } catch (error) {
        console.error('记录登录日志时出错:', error);
      }
    }

    // ============================================
    // UI更新
    // ============================================

    function updateAuthUI() {
      // 触发自定义事件，让UI组件更新
      const event = new CustomEvent('authStateChanged', {
        detail: { user: currentUser }
      });
      document.dispatchEvent(event);
    }

    // ============================================
    // 初始化
    // ============================================

    // 页面加载时获取当前用户
    async function init() {
      console.log('auth.js init: 开始初始化');
      
      // 检查URL hash中是否有认证token（邮箱验证回调）
      const hashParams = new URLSearchParams(window.location.hash.substring(1));
      const accessToken = hashParams.get('access_token');
      const type = hashParams.get('type');
      
      // 如果当前页面不是验证页面，但有验证token，重定向到验证页面
      if (accessToken && type === 'signup' && !window.location.pathname.includes('/auth/verify')) {
        const baseUrl = window.location.pathname.startsWith('/papercache') 
          ? '/papercache' 
          : '';
        window.location.href = baseUrl + '/auth/verify.html' + window.location.hash;
        return;
      }
      
      // 快速路径：如果已有有效的全局状态，快速验证即可
      if (currentUser && window._authCurrentUser && currentUser.id === window._authCurrentUser.id) {
        console.log('auth.js init: ⚡ 快速路径 - 检测到有效全局状态', currentUser.email);
        try {
          // 快速检查 session 是否仍然有效（只需要一次快速检查）
          const { data: { session } } = await supabase.auth.getSession();
          if (session?.user && session.user.id === currentUser.id) {
            console.log('auth.js init: ✅ 快速路径 - session有效，跳过完整初始化');
            // session有效，用户状态已正确，只需要通知监听器即可
            authStateListeners.forEach(listener => {
              try {
                listener(currentUser, 'SIGNED_IN');
              } catch (e) {
                console.error('Auth state listener error:', e);
              }
            });
            updateAuthUI();
            console.log('auth.js init: ✅ 快速路径 - UI已更新，跳过重复profile查询');
            return; // 快速路径完成，跳过完整初始化
          } else {
            console.log('auth.js init: ⚠️ 快速路径 - session无效或用户不匹配，执行完整初始化');
            // session无效，继续执行完整初始化
          }
        } catch (quickCheckError) {
          console.warn('auth.js init: ⚠️ 快速路径 - session检查失败，执行完整初始化', quickCheckError);
          // 检查失败，继续执行完整初始化
        }
      }
      
      try {
        // 完整初始化路径：先快速检查session（从localStorage读取，不需要网络请求）
        console.log('auth.js init: 🔍 开始检查session（完整初始化路径）...');
        const sessionStartTime = Date.now();
        const { data: { session }, error: sessionError } = await supabase.auth.getSession();
        const sessionDuration = Date.now() - sessionStartTime;
        
        if (sessionError) {
          console.warn(`auth.js init: ⚠️ getSession返回错误（耗时${sessionDuration}ms）`, sessionError.code, sessionError.message);
        } else if (session?.user) {
          console.log(`auth.js init: ✅ getSession成功，有session（耗时${sessionDuration}ms）`, '用户:', session.user.email, 'ID:', session.user.id);
        } else {
          console.log(`auth.js init: ⚠️ getSession返回空session（耗时${sessionDuration}ms）`, 'session:', session, 'error:', sessionError);
        }
        
        if (session?.user) {
          // 如果有session，立即设置用户状态（即使profile还没加载）
          console.log('auth.js init: ✅ 检测到session，用户', session.user.email);
          currentUser = {
            ...session.user,
            profile: null // 稍后异步加载
          };
          // 同步到全局变量
          window._authCurrentUser = currentUser;
          console.log('auth.js init: ✅ 立即设置用户状态并同步到全局变量');
          
          // 立即通知监听器（不等待profile加载）
          authStateListeners.forEach(listener => {
            try {
              listener(currentUser, 'SIGNED_IN');
            } catch (e) {
              console.error('Auth state listener error:', e);
            }
          });
          updateAuthUI();
          console.log('auth.js init: ✅ UI已更新（使用基本用户信息）');
          
          // 异步加载完整的用户信息（包括profile），但不阻塞
          console.log('auth.js init: 🔄 开始异步加载完整用户信息（包括profile）...');
          getCurrentUser().then(fullUser => {
            if (fullUser) {
              console.log('auth.js init: ✅ 完整用户信息加载成功', fullUser.email);
              currentUser = fullUser;
              // 同步到全局变量
              window._authCurrentUser = currentUser;
              // 再次通知监听器（更新后的完整信息）
              authStateListeners.forEach(listener => {
                try {
                  listener(currentUser, 'SIGNED_IN');
                } catch (e) {
                  console.error('Auth state listener error:', e);
                }
              });
              updateAuthUI();
              console.log('auth.js init: ✅ UI已更新（使用完整用户信息）');
            } else {
              // 如果getCurrentUser返回null，不应该清除已有的currentUser
              // 因为之前已经确认有session了，可能是临时性的问题
              console.warn('auth.js init: ⚠️ getCurrentUser返回null，但session存在，保留当前用户状态');
              // 不更新currentUser，保持已有的状态（全局变量也保持不变）
            }
          }).catch(err => {
            console.warn('auth.js init: ⚠️ 加载完整用户信息失败（不影响登录状态）:', err.message || err);
            // 即使profile加载失败，用户仍然已登录，不改变currentUser
            // 确保全局变量仍然保持
            if (!window._authCurrentUser && currentUser) {
              window._authCurrentUser = currentUser;
              console.log('auth.js init: ✅ 恢复全局用户状态（profile加载失败但session有效）');
            }
          });
        } else {
          // 如果没有session，检查是否是因为页面刚加载时session还没恢复
          // 重要：如果之前已经有currentUser（可能是从另一个页面跳转过来的），不要立即清除
          console.log('auth.js init: ⚠️ session为空，检查是否有全局用户状态');
          
          // 如果当前已经有用户状态（可能是从其他页面带来的），先保留它
          if (currentUser !== null && currentUser !== undefined) {
            console.log('auth.js init: ✅ 检测到已有用户状态（从全局变量恢复），先保留', currentUser.email, 'ID:', currentUser.id);
            // 尝试通过getUser验证状态是否仍然有效
            try {
              console.log('auth.js init: 🔍 开始调用getUser()验证用户状态...');
              const getUserStartTime = Date.now();
              const { data: { user }, error: getUserError } = await supabase.auth.getUser();
              const getUserDuration = Date.now() - getUserStartTime;
              
              if (getUserError) {
                console.warn(`auth.js init: ⚠️ getUser返回错误（耗时${getUserDuration}ms）`, '错误代码:', getUserError.code, '错误信息:', getUserError.message, '状态码:', getUserError.status);
              } else if (user) {
                console.log(`auth.js init: ✅ getUser成功（耗时${getUserDuration}ms）`, '用户:', user.email, 'ID:', user.id);
              } else {
                console.warn(`auth.js init: ⚠️ getUser返回null（耗时${getUserDuration}ms）`, '没有用户数据');
              }
              if (getUserError) {
                // 检查错误类型：只有明确的认证失败才清除状态
                if (getUserError.message?.includes('JWT') || 
                    getUserError.message?.includes('expired') ||
                    getUserError.message?.includes('invalid') ||
                    getUserError.status === 401) {
                  console.log('auth.js init: token已过期，检查全局状态', getUserError.message);
                  // 只有在确实没有全局用户状态时才清除
                  if (!window._authCurrentUser) {
                    currentUser = null;
                    window._authCurrentUser = null;
                    // 不立即通知，让onAuthStateChange处理
                  } else {
                    console.warn('auth.js init: token验证失败但有全局用户状态，保留状态', window._authCurrentUser.email);
                    currentUser = window._authCurrentUser;
                    // 通知监听器状态仍然有效
                    authStateListeners.forEach(listener => {
                      try {
                        listener(currentUser, 'SIGNED_IN');
                      } catch (e) {
                        console.error('Auth state listener error:', e);
                      }
                    });
                    updateAuthUI();
                  }
                } else {
                  console.warn('auth.js init: getUser失败，可能是网络问题，保留现有状态', getUserError.message);
                  // 网络问题等临时错误，保留状态，等待重试
                  // 如果有全局状态，确保使用它
                  if (window._authCurrentUser && currentUser?.id === window._authCurrentUser.id) {
                    currentUser = window._authCurrentUser;
                    console.log('auth.js init: 使用全局用户状态（网络错误）', currentUser.email);
                  }
                }
                return;
              } else if (user && user.id === currentUser.id) {
                // 用户仍然有效，只是session暂时不可用
                console.log('auth.js init: 用户仍然有效，更新状态', user.email);
                let profile = null;
                try {
                  // 快速获取profile，如果超时则使用默认值
                  profile = await Promise.race([
                    getUserProfile(user.id),
                    new Promise((_, reject) => setTimeout(() => reject(new Error('获取profile超时')), 3000))
                  ]);
                } catch (profileError) {
                  console.warn('auth.js init: 获取profile超时或失败，使用默认值', profileError.message);
                  // 使用默认profile，不阻塞状态恢复
                }
                currentUser = {
                  ...user,
                  profile: profile || {
                    id: user.id,
                    username: user.user_metadata?.username || user.email?.split('@')[0] || 'user',
                    avatar_url: null,
                    full_name: null,
                    bio: null
                  }
                };
                // 同步到全局变量
                window._authCurrentUser = currentUser;
                // 通知监听器状态已更新
                authStateListeners.forEach(listener => {
                  try {
                    listener(currentUser, 'SIGNED_IN');
                  } catch (e) {
                    console.error('Auth state listener error:', e);
                  }
                });
                updateAuthUI();
                return;
              } else if (user && user.id !== currentUser.id) {
                // 不同的用户，更新为新的用户
                console.log('auth.js init: 检测到不同用户，更新状态', user.email);
                let profile = null;
                try {
                  // 快速获取profile，如果超时则使用默认值
                  profile = await Promise.race([
                    getUserProfile(user.id),
                    new Promise((_, reject) => setTimeout(() => reject(new Error('获取profile超时')), 3000))
                  ]);
                } catch (profileError) {
                  console.warn('auth.js init: 获取profile超时或失败，使用默认值', profileError.message);
                  // 使用默认profile，不阻塞状态恢复
                }
                currentUser = {
                  ...user,
                  profile: profile || {
                    id: user.id,
                    username: user.user_metadata?.username || user.email?.split('@')[0] || 'user',
                    avatar_url: null,
                    full_name: null,
                    bio: null
                  }
                };
                window._authCurrentUser = currentUser;
                authStateListeners.forEach(listener => {
                  try {
                    listener(currentUser, 'SIGNED_IN');
                  } catch (e) {
                    console.error('Auth state listener error:', e);
                  }
                });
                updateAuthUI();
                return;
              }
            } catch (e) {
              console.warn('auth.js init: getUser异常，但保留现有状态', e);
              // 异常时不清除状态，可能是临时问题
              return;
            }
          }
          
          // 如果没有现有用户状态，尝试通过getUser获取
          console.log('auth.js init: ⚠️ 无现有用户状态，尝试getUser');
          console.log('auth.js init: 📊 当前状态统计 - currentUser:', currentUser ? `${currentUser.email} (${currentUser.id})` : 'null', 'window._authCurrentUser:', window._authCurrentUser ? `${window._authCurrentUser.email} (${window._authCurrentUser.id})` : 'null');
          try {
            console.log('auth.js init: 🔍 开始调用getUser()...');
            const getUserStartTime = Date.now();
            const { data: { user }, error: getUserError } = await supabase.auth.getUser();
            const getUserDuration = Date.now() - getUserStartTime;
            
            if (getUserError) {
              console.warn(`auth.js init: ⚠️ getUser返回错误（耗时${getUserDuration}ms）`, '错误代码:', getUserError.code, '错误信息:', getUserError.message, '状态码:', getUserError.status);
            } else if (user) {
              console.log(`auth.js init: ✅ getUser成功（耗时${getUserDuration}ms）`, '用户:', user.email, 'ID:', user.id);
            } else {
              console.warn(`auth.js init: ⚠️ getUser返回null（耗时${getUserDuration}ms）`, '没有用户数据');
            }
            if (getUserError) {
              // 检查是否是明确的认证失败
              if (getUserError.message?.includes('JWT') || 
                  getUserError.message?.includes('expired') ||
                  getUserError.message?.includes('invalid') ||
                  getUserError.status === 401) {
                console.log('auth.js init: 明确的认证失败，用户未登录', getUserError.message);
                // 只有在确实没有全局用户状态时才清除
                if (!window._authCurrentUser) {
                  currentUser = null;
                  window._authCurrentUser = null;
                } else {
                  console.warn('auth.js init: getUser失败但有全局用户状态，保留状态');
                  currentUser = window._authCurrentUser;
                }
              } else {
                console.log('auth.js init: getUser失败，可能是临时问题，保留现有状态', getUserError.message);
                // 其他错误（如网络问题），保留现有状态，不立即清除
                // 如果有全局状态，使用它
                if (window._authCurrentUser) {
                  currentUser = window._authCurrentUser;
                  console.log('auth.js init: 使用全局用户状态', currentUser.email);
                }
              }
            } else if (user) {
              // getUser成功，说明用户已登录但session可能还没恢复
              console.log('auth.js init: ✅ getUser成功，恢复用户状态', user.email);
              let profile = null;
              try {
                // 快速获取profile，如果超时则使用默认值，不阻塞状态恢复
                console.log('auth.js init: 🔍 开始获取profile...');
                profile = await Promise.race([
                  getUserProfile(user.id),
                  new Promise((_, reject) => setTimeout(() => reject(new Error('获取profile超时')), 3000))
                ]);
                console.log('auth.js init: ✅ profile获取成功');
              } catch (profileError) {
                console.warn('auth.js init: ⚠️ 获取profile超时或失败，使用默认值（不阻塞状态恢复）', profileError.message);
                // 使用默认profile，不阻塞状态恢复
              }
              currentUser = {
                ...user,
                profile: profile || {
                  id: user.id,
                  username: user.user_metadata?.username || user.email?.split('@')[0] || 'user',
                  avatar_url: null,
                  full_name: null,
                  bio: null
                }
              };
              // 同步到全局变量
              window._authCurrentUser = currentUser;
              console.log('auth.js init: ✅ 用户状态已恢复并同步到全局变量', currentUser.email);
              // 通知所有监听器
              authStateListeners.forEach(listener => {
                try {
                  listener(currentUser, 'SIGNED_IN');
                } catch (e) {
                  console.error('Auth state listener error:', e);
                }
              });
              updateAuthUI();
              console.log('auth.js init: ✅ UI已更新，登录状态已恢复');
            } else {
              // 没有用户
              console.log('auth.js init: getUser返回null，没有用户');
              currentUser = null;
              window._authCurrentUser = null;
              // 不立即通知SIGNED_OUT，等待onAuthStateChange
            }
          } catch (getUserException) {
            console.error('auth.js init: getUser异常:', getUserException);
            // 异常时不立即清除状态，避免误判
            // 只在不明确时才设为null
            if (currentUser === null || currentUser === undefined) {
              currentUser = null;
              window._authCurrentUser = null;
            }
          }
        }
      } catch (error) {
        console.error('auth.js init: 初始化认证状态失败:', error);
        // 初始化失败时，不要立即清除状态
        // 如果已经有用户状态，保留它
        if (currentUser === null || currentUser === undefined) {
          // 只在确实没有用户状态时才设置为null
          try {
            const { data: { user } } = await supabase.auth.getUser();
            if (user) {
              console.log('auth.js init: 异常后通过getUser恢复用户状态', user.email);
              const profile = await getUserProfile(user.id);
              currentUser = {
                ...user,
                profile: profile || {
                  id: user.id,
                  username: user.user_metadata?.username || user.email?.split('@')[0] || 'user',
                  avatar_url: null,
                  full_name: null,
                  bio: null
                }
              };
              // 同步到全局变量
              window._authCurrentUser = currentUser;
              authStateListeners.forEach(listener => {
                try {
                  listener(currentUser, 'SIGNED_IN');
                } catch (e) {
                  console.error('Auth state listener error:', e);
                }
              });
              updateAuthUI();
            } else {
              currentUser = null;
              window._authCurrentUser = null;
            }
          } catch (e) {
            console.error('auth.js init: 恢复用户状态也失败:', e);
            // 只在确实没有用户状态时才设置为null
            if (currentUser === null || currentUser === undefined) {
              currentUser = null;
              window._authCurrentUser = null;
            }
          }
        }
      }
    }

    // DOM加载完成后初始化
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    // ============================================
    // 导出API
    // ============================================

    window.authService = {
      getCurrentUser,
      signInWithOAuth,
      signInWithEmail,
      signUpWithEmail,
      resetPasswordForEmail,
      updatePassword,
      resendConfirmationEmail,
      signOut,
      onAuthStateChange,
      getUserProfile
    };
  }
})();
