---
layout: null
---

<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
  <link href="{{ site.url }}{{ site.baseurl }}/feeds/diffusions.xml" rel="self" type="application/atom+xml" />
  <link href="{{ site.url }}{{ site.baseurl }}/" rel="alternate" type="text/html" />
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ site.url }}{{ site.baseurl }}/feeds/diffusions.xml</id>
  <title type="html">{{ site.title | escape }} - Diffusions 分类</title>
  <subtitle>扩散模型（Diffusions）相关论文 RSS 订阅</subtitle>
  <author>
    <name>{{ site.author.name }}</name>
    <email>{{ site.author.email }}</email>
  </author>
  {%- assign diffusions_posts = '' | split: '' -%}
  {%- for post in site.posts -%}
    {%- if post.categories contains 'diffusions' -%}
      {%- assign diffusions_posts = diffusions_posts | push: post -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign count = 0 -%}
  {%- assign displayed_posts = '' | split: '' -%}
  {%- comment -%} 优先显示有 added_date 的文章 {%- endcomment -%}
  {%- for post in diffusions_posts -%}
    {%- if post.added_date and count < 20 -%}
      {%- assign displayed_posts = displayed_posts | push: post -%}
      {%- assign count = count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
  {%- for post in diffusions_posts -%}
    {%- unless post.added_date -%}
      {%- if count < 20 -%}
        {%- assign displayed_posts = displayed_posts | push: post -%}
        {%- assign count = count | plus: 1 -%}
      {%- endif -%}
    {%- endunless -%}
  {%- endfor -%}
  {%- if displayed_posts.size == 0 -%}
    {%- assign displayed_posts = diffusions_posts -%}
  {%- endif -%}
  {%- assign latest_posts = displayed_posts | limit: 20 -%}
  {% for post in latest_posts %}
  <entry>
    <title type="html">{{ post.title | escape }}</title>
    <link href="{{ site.url }}{{ site.baseurl }}{{ post.url }}" rel="alternate" type="text/html" title="{{ post.title | escape }}" />
    {%- assign publish_date = post.added_date | default: post.date -%}
    <published>{{ publish_date | date_to_xmlschema }}</published>
    <updated>{{ publish_date | date_to_xmlschema }}</updated>
    <id>{{ site.url }}{{ site.baseurl }}{{ post.url }}</id>
    <content type="html" xml:base="{{ site.url }}{{ site.baseurl }}{{ post.url }}">
      <![CDATA[{{ post.excerpt | strip_html | truncate: 200 | escape }}]]>
    </content>
    <category term="diffusions" />
  </entry>
  {% endfor %}
</feed>

