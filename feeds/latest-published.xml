---
layout: null
---

<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
  <link href="{{ site.url }}{{ site.baseurl }}/feeds/latest-published.xml" rel="self" type="application/atom+xml" />
  <link href="{{ site.url }}{{ site.baseurl }}/" rel="alternate" type="text/html" />
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ site.url }}{{ site.baseurl }}/feeds/latest-published.xml</id>
  <title type="html">{{ site.title | escape }} - 最新发表</title>
  <subtitle>按论文发表时间排序的最新 {{ site.title | escape }} 论文</subtitle>
  <author>
    <name>{{ site.author.name }}</name>
    <email>{{ site.author.email }}</email>
  </author>
  {%- comment -%} 按论文发表时间（date）排序，最新的在前 {%- endcomment -%}
  {%- assign sorted_by_date = site.posts | sort: 'date' | reverse -%}
  {%- assign latest_published = sorted_by_date | limit: 10 -%}
  {% for post in latest_published %}
  <entry>
    <title type="html">{{ post.title | escape }}</title>
    <link href="{{ site.url }}{{ site.baseurl }}{{ post.url }}" rel="alternate" type="text/html" title="{{ post.title | escape }}" />
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    <id>{{ site.url }}{{ site.baseurl }}{{ post.url }}</id>
    <content type="html" xml:base="{{ site.url }}{{ site.baseurl }}{{ post.url }}">
      <![CDATA[{{ post.excerpt | strip_html | truncate: 200 | escape }}]]>
    </content>
    {%- if post.categories.size > 0 -%}
    <category term="{{ post.categories | first | escape }}" />
    {%- endif -%}
  </entry>
  {% endfor %}
</feed>

