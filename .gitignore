# Jekyll
_site/
.jekyll-cache/
.jekyll-metadata

# Sass
.sass-cache/

# Temporary thumbnail cache (local development only)
.thumb_tmp/

# Generated thumbnails (committed in CI, but ignore local temp files)
# Note: assets/images/thumbs/ and _data/thumbnails_by_path.yml are committed by CI
assets/images/thumbs/*.tmp
assets/images/thumbs/.gitkeep

# Slides (not committed to git, synced from deepnotes during build)
# Note: _slides/ is synced from deepnotes in deploy-pages.yml, not committed to git
_slides/

# Others
.DS_Store
Gemfile.lock

# Environment variables
.env.local
.env

# Local config backups (may contain sensitive data)
_config_local.yml.bak

# Data files (committed in CI, but ignore local temp files)
# Note: _data/collection_structure.yml, _data/slides_collection_structure.yml, 
#       _data/thumbnails_by_path.yml are committed by CI
_data/*.tmp
_data/.gitkeep

# Assets data (committed in CI, but ignore local temp files)
# Note: assets/data/excerpts.json is committed by CI
assets/data/*.tmp
assets/data/.gitkeep

# Posts (committed in CI)
# Note: _posts/ is committed by CI

vendor/
.bundle/
.vercel

# Python virtual environment
.venv/
venv/
env/

# Node.js dependencies
node_modules/

# Backup directories
bkp/
backup/
